{
  "cleanUrls": true,
  "redirects": [
    { "source": "/projetos/", "destination": "/projetos", "permanent": true },
    { "source": "/projetos/:slug/", "destination": "/projetos/:slug", "permanent": true },
    { "source": "/sites/:slug(caiomartins|dranayane|bigbang|potencialize)", "destination": "/sites/:slug/", "permanent": true },
    { "source": "/sites/potencialize/sobre", "destination": "/sites/potencialize/sobre/", "permanent": true }
  ],
  "rewrites": [
    { "source": "/projetos/:slug(caiomartins|dranayane|bigbang|potencialize)", "destination": "/projeto.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
